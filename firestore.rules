rules_version = '2';
// KUN Maintenance & Housekeeping: only logged-in accounts can read or write.
// Accounts are created by the Head of Accounts in Firebase Authentication (self sign-up switched off).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
