rules_version = '2';
// KUN Maintenance & Housekeeping.
// A log-in sees data only when the Admin has linked it to an active user in the app (members/<uid>),
// or when it is the owner who set the app up. Before set-up, any log-in may run the first-time set-up.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function fresh() { return !exists(/databases/$(database)/documents/cfg/settings); }
    function isOwner() {
      return signedIn() && exists(/databases/$(database)/documents/cfg/meta)
        && get(/databases/$(database)/documents/cfg/meta).data.v.ownerUid == request.auth.uid;
    }
    function memberDoc() { return get(/databases/$(database)/documents/members/$(request.auth.uid)); }
    function member() {
      return signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.uid)) && memberDoc().data.active == true;
    }
    function admin() { return isOwner() || (member() && memberDoc().data.role == 'Admin'); }

    // who may use the app, kept in step with Admin > Users by the Admin's app
    match /members/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || member() || isOwner());
      allow write: if admin();
    }
    // each log-in records its own email so the Admin can find it
    match /people/{uid} {
      allow read: if member() || isOwner();
      allow write: if signedIn() && request.auth.uid == uid;
    }
    // tells the log-in page whether first-time set-up is still open
    match /public/{doc} {
      allow read: if true;
      allow write: if admin() || (signedIn() && fresh());
    }
    // all app data (cfg, registers m_*, number locks)
    match /{coll}/{doc} {
      allow read, write: if coll != 'members' && coll != 'people' && coll != 'public'
        && (member() || isOwner() || (signedIn() && fresh()));
    }
  }
}
