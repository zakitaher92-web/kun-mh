# Copy this file to server/.env and fill in your own values. Never commit server/.env.

# --- Office server (set-up step 4 writes these) ---
PORT=3100
HOST=127.0.0.1

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=kun_mh
DB_USER=kunmh
DB_PASSWORD=
TZ=Asia/Baghdad

# --- Optional ---
# DATABASE_URL=postgres://USER:PASSWORD@HOST/DATABASE   (takes precedence over DB_*; used on Vercel with Neon)
# DB_SSL=require                 (TLS; Neon needs it)
# DB_POOL_MAX=10                 (connections per server process)
# DATA_MODE=kv                   (kv = kv_docs, the default; tables = relational tables, see README)
# COOKIE_SECURE=true             (mark the session cookie Secure; only once HTTPS works)
# LIVE_UPDATES=off               (switch off the database listener for live updates)
